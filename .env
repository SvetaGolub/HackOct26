# Database (MySQL, async-драйвер aiomysql). В Docker хост БД - "db"
DB_NAME=HackOct
DB_USER=hack
DB_PASSWORD=hack
DB_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql+aiomysql://hack:hack26@db:3306/HackOct

# JWT
JWT_SECRET_KEY=generate-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Администратор (создаётся из .env, через панель не управляется)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=HackOctPass2026!

# Telegram
TELEGRAM_BOT_TOKEN=8675239825:AAH2lsn5DpI6YcFWI2FUQqS-R8ysSzT8Xf0
# Обязательно для напоминаний в чат по ТЗ (числовой ID или @channel)
