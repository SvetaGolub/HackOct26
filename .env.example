# Скопируйте в .env и заполните. Не коммитьте реальный .env.

# MySQL (в Docker хост БД — db)
DB_NAME=HackOct
DB_USER=hack
DB_PASSWORD=
DB_ROOT_PASSWORD=
# Должен совпадать с DB_USER / DB_PASSWORD / DB_NAME (compose тоже собирает URL из них)
DATABASE_URL=mysql+aiomysql://hack:CHANGE_ME@db:3306/HackOct

# JWT: уникальная случайная строка минимум 32 байта (например, secrets.token_urlsafe(48))
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
API_DOCS_ENABLED=false

# Системный администратор (создаётся при старте; пароль минимум 12 символов)
ADMIN_LOGIN=
ADMIN_PASSWORD=

# Telegram: токен бота обязателен; чат — куда слать напоминания по ТЗ
TELEGRAM_BOT_TOKEN=
# Числовой ID чата/канала или @username (бот должен быть в чате и иметь право писать)
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=
# Личный Telegram chat ID администратора для обратной связи.
# Если пусто, используется TELEGRAM_CHAT_ID или привязанный Telegram администратора.
ADMIN_TELEGRAM_CHAT_ID=

# Единый часовой пояс для сроков и напоминаний
TIMEZONE=Europe/Moscow
REMINDER_DAYS=3

# CORS и порт веб-панели (nginx)
CORS_ORIGINS=http://localhost
WEB_PORT=80
