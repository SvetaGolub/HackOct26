# Шаблон переменных окружения. Скопируйте в .env и заполните.

# Database (MySQL, async-драйвер aiomysql). В Docker хост БД - "db"
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DATABASE_URL=mysql+aiomysql://hack:change-me@db:3306/HackOct

# JWT
JWT_SECRET_KEY=generate-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Администратор (создаётся из .env, через панель не управляется)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me

# Telegram
TELEGRAM_BOT_TOKEN=8675239825:AAHfgAWoudLiE4jxveCa-8io836FLi1WZFg

# Единый часовой пояс для сроков и напоминаний
TIMEZONE=Europe/Moscow

# CORS (адреса фронта через запятую)
CORS_ORIGINS=http://185.96.80.125:8000