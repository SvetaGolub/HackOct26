# Configure every value before starting the application. Never commit your real .env.
DB_NAME=HackOct
DB_USER=hack
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Fill in each value before starting the application. JWT_SECRET_KEY must be at
# least 32 bytes; ADMIN_LOGIN must be an email address.
JWT_SECRET_KEY=
ADMIN_LOGIN=
ADMIN_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Numeric chat ID or @channel username the bot can post to.
TELEGRAM_CHAT_ID=

TIMEZONE=Europe/Moscow
REMINDER_DAYS=3
CORS_ORIGINS=http://localhost
WEB_PORT=80
